# Copy this file to ".env" (the name starts with a dot and has NO .txt at the end) in the SAME folder as server.js.
# NEVER commit ".env". All values below are placeholders: any value left as an example is ignored by the server.
# Windows tip: create it with  copy .env.example .env  (do not use "echo ... > .env" in PowerShell: it saves UTF-16).

# ---- AI (server only) ----
GROQ_API_KEY=your_groq_api_key_here
# Groq shut down llama-3.3-70b-versatile and llama-3.1-8b-instant on 2026-08-16. Check console.groq.com/docs/models for current names.
GROQ_MODEL=openai/gpt-oss-120b
# Max AI questions per student per day (protects your Groq quota)
CHAT_DAILY_LIMIT=150

# ---- Sessions (server only) ----
# Random string of 32+ characters. Create one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=replace_with_a_long_random_string

# ---- Supabase (server only) ----
# Dashboard -> Project Settings -> API.
# SUPABASE_URL = the Project URL only, like https://abcdefghijkl.supabase.co  (no /rest/v1, no dashboard link, no quotes needed).
# SUPABASE_SERVICE_ROLE_KEY = the SECRET / service_role key of the SAME project.
# Never put this key in index.html and never use it in a public repository.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_secret_or_service_role_key_here

# ---- Password-reset email (optional, uses resend.com) ----
RESEND_API_KEY=
MAIL_FROM=EngineerPath AI <no-reply@your-domain.example>

# ---- Server ----
PORT=3000
# Set to "production" when hosting. Turns on Secure cookies and refuses to start without Supabase + SESSION_SECRET.
NODE_ENV=development
# Set to 1 only if a reverse proxy (Render, Railway, nginx...) sits in front, so real visitor IPs are used for rate limits.
TRUST_PROXY=0
